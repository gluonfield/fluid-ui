# Backend endpoints

## Get all components

curl --request GET \
  --url http://localhost:8000/ui/components \
  --header 'User-Agent: insomnia/11.0.2'

## Get Component by id 

curl --request GET \
  --url http://localhost:8000/ui/components/header1 \
  --header 'User-Agent: insomnia/11.0.2'

## Change Position

curl --request PATCH \
  --url http://localhost:8000/ui/components/position/header1 \
  --header 'Content-Type: application/json' \
  --header 'User-Agent: insomnia/11.0.2' \
  --data '{
    "x": 10,
    "y": 12
}'
